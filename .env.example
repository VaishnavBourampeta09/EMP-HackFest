# Preferred production providers
MAPBOX_ACCESS_TOKEN=
OTP_URL=

# Public, no-key development fallbacks (walking/geocoding only)
VALHALLA_URL=https://valhalla1.openstreetmap.de
NOMINATIM_URL=https://nominatim.openstreetmap.org
ROUTING_ALLOW_PUBLIC_FALLBACK=true

# Identifies low-volume public geocoder requests during development
SENTINEL_CONTACT_EMAIL=
APP_BASE_URL=http://localhost:3000

# Public routing application identifier
VALHALLA_CLIENT_ID=escort-hackfest

# Optional ArcGIS override; defaults to the official City of Redmond layer
REDMOND_CRIME_FEATURE_LAYER_URL=https://gis.redmond.gov/arcgis/rest/services/CrimeMap/Crimes/FeatureServer/0
